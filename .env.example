# Bu dosyayı kopyalayıp adını ".env" yapın. .env GitHub'a GÖNDERİLMEZ (şifre içerir).
# Windows:  copy .env.example .env      Mac/Linux:  cp .env.example .env
POSTGRES_HOST=localhost
# Bilgisayarınızda başka bir PostgreSQL zaten 5432'yi kullanıyorsa 5433 yapın
POSTGRES_PORT=5432
POSTGRES_DB=churn
POSTGRES_USER=churn
POSTGRES_PASSWORD=churn
